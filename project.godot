; AFTERZERO — Action Survival Exploration
; Godot 4.7.2 Stable / Compatibility renderer
config_version=5

[application]
config/name="AFTERZERO"
config/version="0.1.0"
config/description="Change the world. Survive what follows."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/afterzero_icon.svg"

[autoload]
GameState="*res://scripts/core/game_state.gd"
ZoneState="*res://scripts/world/zone_state.gd"
SaveService="*res://scripts/core/save_service.gd"
BuildSystem="*res://scripts/core/build_system.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/energy_saving/keep_screen_on=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.075, 1.0)

[physics]
common/physics_ticks_per_second=60

[internationalization]
locale/fallback="en"
rendering/root_node_layout_direction=0
